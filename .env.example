# Copier ce fichier en `.env` puis compléter. Le fichier .env n'est jamais versionné.

# --- Adresses -----------------------------------------------------------------
# Adresse publique du site (liens absolus, référencement, aperçu du brouillon).
SITE_URL=https://ov7.fr
# Domaine(s) qui servent le logiciel d'administration, séparés par des virgules.
ADMIN_HOSTS=admin.ov7.fr

# --- Compte du logiciel ---------------------------------------------------------
# Utilisés UNE SEULE FOIS, au premier démarrage, pour créer le compte.
# Le mot de passe est ensuite stocké haché dans data/auth.json et se change
# depuis le logiciel (Compte) ou avec `docker compose exec ov7 npm run set-password`.
# Vous pouvez vider ADMIN_PASSWORD après le premier démarrage.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Tunnel Cloudflare ----------------------------------------------------------
# Jeton du tunnel (Zero Trust > Réseaux > Tunnels > votre tunnel > Docker).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Mises à jour depuis le logiciel ---------------------------------------------
# true : le logiciel peut installer la dernière version du dépôt git (git pull).
UPDATES_ENABLED=true
UPDATE_REMOTE=origin
UPDATE_BRANCH=main

# --- Facultatif -----------------------------------------------------------------
# Notification Discord à chaque message reçu (URL de webhook, reste sur le serveur).
DISCORD_WEBHOOK_URL=
# Durée des sessions du logiciel, en jours.
SESSION_DAYS=7
# Cookies « Secure » (HTTPS). Activé par défaut en production, à laisser ainsi
# derrière Cloudflare. Ne passer à false que pour un test en HTTP sur le réseau local.
# SECURE_COOKIES=true
